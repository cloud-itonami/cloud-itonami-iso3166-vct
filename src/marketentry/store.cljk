    "eng-4" {:id "eng-4" :operator "Union Island Export Ltd" :portal "procurement.gov.vc/eprocure"
             :base-fee 500000 :monthly-rate 30000 :monitoring-months 12
             :claimed-fee 860000.0
             :debarment-committee-established? true :debarment-sanction-kind nil
             :debarment-sanction-years nil :debarment-sanction-start-date nil
             :conditional-non-debarment-breached? false :submission-date "2026-07-23"
             :requires-tin? true :tin-verified? true
             :drafted? false :submitted? false
             :jurisdiction "VCT" :status :intake}
    "eng-5" {:id "eng-5" :operator "Georgetown Logistics" :portal "procurement.gov.vc/eprocure"
             :base-fee 500000 :monthly-rate 30000 :monitoring-months 12
             :claimed-fee 860000.0
             :debarment-committee-established? false :debarment-sanction-kind nil
             :debarment-sanction-years nil :debarment-sanction-start-date nil
             :conditional-non-debarment-breached? false :submission-date "2026-07-23"
             :requires-tin? true :tin-verified? false
             :drafted? false :submitted? false
             :jurisdiction "VCT" :status :intake}
    ;; eng-6: a LAWFUL 1-year Temporary Debarment (Schedule 4 §7(1)(c)'s
    ;; own shortest enum value) whose computed window (2024-06-01 ..
    ;; 2025-06-01) has already lapsed well before :submission-date --
    ;; NOT disqualifying, unlike eng-4's still-active interim case.
    "eng-6" {:id "eng-6" :operator "Layou Builders Ltd" :portal "procurement.gov.vc/eprocure"
             :base-fee 500000 :monthly-rate 30000 :monitoring-months 12
