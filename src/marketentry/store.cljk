             :debarment-sanction-years 1 :debarment-sanction-start-date "2024-06-01"
             :conditional-non-debarment-breached? false :submission-date "2026-07-23"
             :requires-tin? true :tin-verified? true
             :drafted? false :submitted? false
             :jurisdiction "VCT" :status :intake}
    ;; eng-7: :debarment-sanction-years (2) is NOT a member of Schedule
    ;; 4 §7(1)(c)'s own statutory enum {1, 3, 5} -- an untrustworthy
    ;; record, held regardless of how long ago :debarment-sanction-
    ;; start-date was (demonstrates the invalid-years leg fires
    ;; independently of the window-overlap leg).
    "eng-7" {:id "eng-7" :operator "Chateaubelair Fisheries Co-op" :portal "procurement.gov.vc/eprocure"
             :base-fee 500000 :monthly-rate 30000 :monitoring-months 12
