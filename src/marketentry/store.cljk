             :debarment-sanction-years 2 :debarment-sanction-start-date "2020-01-01"
             :conditional-non-debarment-breached? false :submission-date "2026-07-23"
             :requires-tin? true :tin-verified? true
             :drafted? false :submitted? false
             :jurisdiction "VCT" :status :intake}
    ;; eng-8: Permanent Debarment (Schedule 4 §7(1)(d)) -- ALWAYS
    ;; disqualifying, no expiry date at all, regardless of how long ago
    ;; any dates on file might suggest.
    "eng-8" {:id "eng-8" :operator "Owia Holdings Inc" :portal "procurement.gov.vc/eprocure"
             :base-fee 500000 :monthly-rate 30000 :monitoring-months 12
             :claimed-fee 860000.0
             :debarment-committee-established? false :debarment-sanction-kind :permanent
             :debarment-sanction-years nil :debarment-sanction-start-date nil
             :conditional-non-debarment-breached? false :submission-date "2026-07-23"
             :requires-tin? true :tin-verified? true
             :drafted? false :submitted? false
             :jurisdiction "VCT" :status :intake}
    ;; eng-9: Conditional Non-Debarment that HAS been breached
    ;; (Schedule 4 §7(1)(b)'s own auto-conversion) -- falls through to
