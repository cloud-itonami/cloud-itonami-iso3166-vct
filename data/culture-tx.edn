#:culture{:id "vct.dish.breadfruit", :name "Breadfruit", :country "VCT", :kind :dish, :summary "Roasted breadfruit served with fried jackfish is Saint Vincent and the Grenadines' national dish; the tree was famously carried to St. Vincent aboard William Bligh's 1791 expedition.", :url "https://en.wikipedia.org/wiki/Breadfruit", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "vct.dish.ducana", :name "Ducana", :country "VCT", :kind :dish, :summary "Sweet potato dumpling or pudding, made with grated sweet potato, coconut, sugar, flour and spices boiled in salted water; eaten in Saint Vincent and the Grenadines and other Caribbean islands.", :url "https://en.wikipedia.org/wiki/Ducana", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "vct.dish.pelau", :name "Pelau", :country "VCT", :kind :dish, :summary "Traditional West Indian rice dish made by caramelizing meat in brown sugar before adding rice, legumes and coconut milk; Wikipedia categorizes it as part of Saint Vincent and the Grenadines cuisine.", :url "https://en.wikipedia.org/wiki/Pelau", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "vct.product.arrowroot", :name "Saint Vincent arrowroot", :country "VCT", :kind :product, :summary "Saint Vincent has a long history of arrowroot production, growing from Carib and Garifuna food/medicine use into a major export contributing close to 50% of the country's foreign export earnings between 1900 and 1965.", :url "https://en.wikipedia.org/wiki/Arrowroot", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "vct.craft.moko-jumbie", :name "Moko jumbie", :country "VCT", :kind :craft, :summary "Traditional stilt-walking masquerade costume of West African origin; records from the 1870s describe early Moko Jumbie costumes in Saint Vincent and the Grenadines made from European women's dresses over petticoats with headdresses.", :url "https://en.wikipedia.org/wiki/Moko_jumbie", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "vct.craft.bequia-whaling", :name "Bequia whaling", :country "VCT", :kind :craft, :summary "Bequia natives are permitted up to four humpback whales per year using traditional hand-thrown harpoons from small open sailboats, a practice introduced by Yankee whalers in the 19th century and classified by the IWC as aboriginal whaling.", :url "https://en.wikipedia.org/wiki/Bequia", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "vct.festival.vincy-mas", :name "Vincy Mas", :country "VCT", :kind :festival, :summary "Carnival of Saint Vincent and the Grenadines, held late June/early July, listed among the Caribbean's national carnivals.", :url "https://en.wikipedia.org/wiki/List_of_Caribbean_carnivals_around_the_world", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "vct.heritage.la-soufriere", :name "La Soufrière", :country "VCT", :kind :heritage, :summary "Active volcano on the island of Saint Vincent standing 1,235 meters, the highest peak in Saint Vincent and the Grenadines, with eight recorded eruptions since 1718 including December 2020-April 2021.", :url "https://en.wikipedia.org/wiki/La_Soufri%C3%A8re_(Saint_Vincent)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
]
